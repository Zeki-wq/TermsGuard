{
  "manifest_version": 3,
  "name": "TermsGuard — Sözleşme Risk Analizörü",
  "version": "1.0.0",
  "description": "Kullanım Koşulları, Gizlilik Politikaları ve abonelik sözleşmelerini yapay zeka ve kanıt doğrulaması ile inceleyen şeffaf analiz aracı.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "TermsGuard Risk Analizörü"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
