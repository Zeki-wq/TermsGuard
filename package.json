{
  "name": "termsguard",
  "version": "1.0.0",
  "description": "Evidence-Based Terms of Service Risk Analyzer - Chrome Extension Manifest V3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/compile-schemas.js && tsc && vite build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "eval": "tsx eval/run-eval.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^14.1.0",
    "eslint": "^9.20.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
